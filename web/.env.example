# ==============================================================================
# JahePasti Environment Configuration (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==============================================================================

# 1. Aplikasi Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="jahepasti-secret-session-key-minimum-32-chars-long"

# 2. Solana On-Chain Program (Devnet)
# Program ID Anchor Rust resmi yang telah di-deploy ke Solana Devnet:
NEXT_PUBLIC_JAHEPASTI_PROGRAM_ID="2ahgAPJf9QrTpS3BvmAVKGwB8Q91tuZjYniWTodYZfCL"
SOLANA_NETWORK="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"

# 3. Solana Wallet Payer / Signer (Wallet Pengirim Transaksi)
# Masukkan Base58 Private Key dari wallet Phantom Anda (Opsional).
# Cara mengambil dari ekstensi Phantom:
# Buka Phantom -> Klik Ikon Settings (Gear) -> Klik Akun Anda -> "Export Private Key" -> Salin Base58 string.
# Jika kosong, server akan menggunakan file keypair lokal (.solana-devnet-keypair.json).
SOLANA_PAYER_PRIVATE_KEY=""

# 4. Database PostgreSQL (Supabase Integration)
# PENTING: Jika variabel ini kosong/belum ada, aplikasi OTOMATIS menggunakan
# penyimpanan lokal persisten (web/data/store.json) sehingga tetap jalan 100% tanpa setup DB.
#
# Cara integrasi dengan Supabase:
# 1. Buat proyek baru di https://supabase.com
# 2. Buka Project Settings -> Database -> Connection string -> Mode: Transaction (URI)
# 3. Ganti [YOUR-PASSWORD] dengan kata sandi database Anda.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# (Opsional) Supabase API Client jika menggunakan Storage bucket untuk foto/CoA asli:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
